FROM --platform=$BUILDPLATFORM docker.io/library/maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B verify

FROM quay.io/keycloak/keycloak:26.8.1@sha256:a78d6b79572168cb25886b80a8b5b8d4ed4390743e3eecb810538683e209dd6b
LABEL org.opencontainers.image.source="https://github.com/iamangus/stalwart-oidc-reconciler"
COPY --from=build --chown=keycloak:keycloak /build/target/srvd-mail-provider-1.0.0.jar /opt/keycloak/providers/srvd-mail-provider.jar
# Keep the same non-optimized startup as the operator's stock-image deployment.
